# API
API_PORT=3000
DB_FILE=data/dormitory.db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
AUDIT_RETENTION_DAYS=90
ADMIN_INITIAL_PASSWORD=replace-before-first-run
PORTAL_BASE_URL=https://dormitory.university.ac.th

# SMTP สำหรับส่งแจ้งลงนามสัญญา หากยังไม่กำหนดระบบจะเก็บไว้ในคิว
SMTP_HOST=smtp.university.ac.th
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dormitory@university.ac.th
SMTP_PASSWORD=replace-with-secret
MAIL_FROM=Campus Nest <dormitory@university.ac.th>

# LDAP / Microsoft AD — ขอค่าจริงจากผู้ดูแลระบบมหาวิทยาลัย
LDAP_URL=ldaps://ad.university.ac.th:636
LDAP_BASE_DN=DC=university,DC=ac,DC=th
LDAP_BIND_DN=CN=service-dormitory,OU=Service Accounts,DC=university,DC=ac,DC=th
LDAP_BIND_PASSWORD=replace-with-secret
LDAP_USER_FILTER=(sAMAccountName={{username}})
